<mjml lang="it">
  <mj-head>
    <mj-title><%-it_subject%></mj-title>
    <mj-attributes>
      <mj-all font-family="system-ui, sans-serif" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
  </mj-head>

  <mj-body css-class="mail-body">
    <mj-raw>
      <#if recipient.recipientType == "PG">
        <#assign sendLoginUrl = ENV["sendLoginUrlPG"]>
      <#else>
        <#assign sendLoginUrl = ENV["sendLoginUrlPF"]>
      </#if>
    </mj-raw>
    <mj-include path="../../styles/style.css" type="css" />

    <mj-wrapper padding="0">
      <!-- Sender header -->
      <mj-section css-class="section informal-section" padding="32px 24px 0">
        <mj-column padding="0">
          <mj-table
            css-class="text"
            color="#17324D"
            padding="0"
          >
            <tr>
              <td style="vertical-align: middle; text-align: left">
                <p style="font-weight: 700; margin: 0">${sender.denomination}</p>
                <p style="font-size: 16px; margin: 8px 0 0">${sender.service}</p>
              </td>
              <#if GENERATED.senderLogoBase64?? && GENERATED.senderLogoBase64?has_content>
              <td
                class="sender-logo-cell"
                style="vertical-align: middle; text-align: right; width: 140px; padding-left: 16px"
              >
                <img
                  src="${GENERATED.senderLogoBase64}"
                  alt="Logo di ${sender.denomination}"
                  style="display: inline-block; max-height: 44px; max-width: 140px; width: auto"
                />
              </td>
              </#if>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section css-class="section informal-section" padding="0 24px">
        <mj-column>
          <mj-divider
            border-color="#E3E7EB"
            border-style="solid"
            border-width="1px"
            padding="18px 0 26px"
          />

          <mj-text
            css-class="title"
            align="left"
            color="#17324D"
            font-size="24px"
            font-weight="600"
            line-height="40px"
            padding="0 0 24px"
          >
            <h1 style="font-size: 24px; font-weight: 600; line-height: 40px; margin: 0">${subject}</h1>
          </mj-text>

          <mj-text
            css-class="text"
            align="left"
            color="#17324D"
            font-size="16px"
            line-height="24px"
            padding="0 0 24px"
          >
            <p style="margin: 0"><%-it_hello%></p>
          </mj-text>

          <mj-text
            css-class="text"
            align="left"
            color="#17324D"
            font-size="16px"
            line-height="24px"
            padding="0"
          >
            <div class="primary-content">${GENERATED.primaryContentHtml}</div>

            <#if GENERATED.secondaryContentHtml?? && GENERATED.secondaryContentHtml?has_content>
            <div class="secondary-content" style="margin-top: 28px">
              ${GENERATED.secondaryContentHtml}
            </div>
            </#if>

            <#if hasAttachment>
            <p style="margin: 32px 0 0"><%-it_attachments_section%></p>
            </#if>

            <#if hasPayment>
            <p style="margin: 20px 0 0"><%-it_payment_section%></p>
            </#if>

            <p style="margin: 28px 0 0"><%-it_contact_sender%></p>
          </mj-text>

          <mj-text align="left" padding="0 0 24px">
            <#if hasPayment>
            <p style="margin: 24px 0 0">
              <a
                href="${sendLoginUrl}"
                title="<%-it_pay_button_cta%>"
                style="background-color: #0B3EE3; border-radius: 8px; color: #FFFFFF; display: inline-block; font-size: 16px; font-weight: 600; line-height: 20px; padding: 14px 24px; text-decoration: none"
              ><%-it_pay_button_cta%></a>
            </p>
            </#if>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section css-class="section informal-section" padding="38px 24px 0">
        <mj-column>
          <mj-table
            css-class="text"
            color="#17324D"
            font-size="16px"
            padding="0 0 24px"
          >
            <tr>
              <td>
                <table
                  align="left"
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                  style="border-collapse: collapse; width: auto"
                >
                  <tr>
                    <td
                      class="send-communication-text"
                      style="line-height: 24px; vertical-align: middle; white-space: nowrap"
                    >
                      <%-it_send_communication%>
                    </td>
                    <td
                      width="75"
                      style="padding-left: 10px; vertical-align: middle; width: 75px"
                    >
                      <img
                        src="https://www.notifichedigitali.it/static/generic_assets/aar-logo-short-small.png"
                        alt="SEND - Servizio Notifiche Digitali"
                        width="75"
                        style="display: block; height: auto; max-width: 75px; width: 75px"
                      />
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </mj-table>

          <mj-divider
            border-color="#E3E7EB"
            border-style="solid"
            border-width="1px"
            padding="0"
          />

          <mj-text
            css-class="footer-text"
            align="left"
            padding="24px 0"
          >
            <p style="margin: 0; font-size: 14px; line-height: 18px; color: #5C6F82"><%-it_footer%></p>
          </mj-text>

          <mj-divider
            border-color="#E3E7EB"
            border-style="solid"
            border-width="1px"
            padding="0 0 24px"
          />
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>

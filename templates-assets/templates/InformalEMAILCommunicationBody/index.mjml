<mjml lang="it">
  <mj-head>
    <mj-title><%-it_subject%></mj-title>
    <mj-attributes>
      <mj-all font-family="system-ui, sans-serif" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-style>
      @media screen and (max-width: 600px) {
        .sender-column { width: auto !important; }
        .sender-logo-column { width: 110px !important; }

        .section > table > tbody > tr > td {
          padding-left: 8px !important;
          padding-right: 8px !important;
        }
      }

      @media screen and (max-width: 340px) {
        .send-communication-text {
          white-space: normal !important;
        }
      }

      .primary-content,
      .secondary-content {
        width: 100% !important;
      }

      .primary-content p,
      .secondary-content p {
        margin: 0 0 16px !important;
        width: 100% !important;
      }

      .primary-content p:last-child,
      .secondary-content p:last-child {
        margin-bottom: 0 !important;
      }

      .banner-box {
        border-radius: 8px;
        overflow: hidden;
      }

      @media (prefers-color-scheme: dark) {
        .banner-box div,
        .banner-box p {
          color: #17324D !important;
        }

        .banner-box a {
          color: #0073E6 !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body css-class="mail-body">
    <mj-include path="../../styles/style.css" type="css" />

    <mj-wrapper padding="0">
      <!-- Sender header -->
      <mj-section css-class="section" padding="32px 24px 0">
        <mj-group vertical-align="middle">
          <mj-column
            css-class="sender-column"
            width="70%"
            padding="0"
            vertical-align="middle"
          >
            <mj-text
              css-class="text"
              align="left"
              color="#17324D"
              padding="0"
            >
              <p style="font-weight: 700; margin: 0">${sender.denomination}</p>
              <p style="font-size: 16px; margin: 8px 0 0">${sender.service}</p>
            </mj-text>
          </mj-column>

          <mj-column
            css-class="sender-logo-column"
            width="30%"
            padding="0"
            vertical-align="middle"
          >
            <mj-text align="right" padding="0">
              <#if GENERATED.senderLogoBase64?? && GENERATED.senderLogoBase64?has_content>
              <img
                src="${GENERATED.senderLogoBase64}"
                alt="Logo di ${sender.denomination}"
                style="display: inline-block; max-height: 44px; max-width: 140px; width: auto"
              />
              </#if>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section css-class="section" padding="0 24px">
        <mj-column>
          <mj-divider
            border-color="#E3E7EB"
            border-style="solid"
            border-width="1px"
            padding="18px 0 26px"
          />

          <mj-text
            css-class="title"
            align="left"
            color="#17324D"
            font-size="24px"
            font-weight="600"
            line-height="40px"
            padding="0 0 24px"
          >
            <h1 style="font-size: 24px; font-weight: 600; line-height: 40px; margin: 0">${subject}</h1>
          </mj-text>

          <mj-text
            css-class="text"
            align="left"
            color="#17324D"
            font-size="16px"
            line-height="24px"
            padding="0 0 24px"
          >
            <p style="margin: 0"><%-it_hello%></p>
          </mj-text>

          <mj-text
            css-class="text"
            align="left"
            color="#17324D"
            font-size="16px"
            line-height="24px"
            padding="0"
          >
            <div class="primary-content">${GENERATED.primaryContentHtml}</div>

            <#if GENERATED.secondaryContentHtml?? && GENERATED.secondaryContentHtml?has_content>
            <div class="secondary-content" style="margin-top: 28px">
              ${GENERATED.secondaryContentHtml}
            </div>
            </#if>

            <#if hasAttachment>
            <p style="margin: 32px 0 0"><%-it_attachments_section%></p>
            </#if>

            <#if hasPayment>
            <p style="margin: 20px 0 0"><%-it_payment_section%></p>
            </#if>

            <p style="margin: 28px 0 0"><%-it_contact_sender%></p>
          </mj-text>

          <mj-text align="left" padding="0 0 24px">
            <#if hasPayment>
            <p style="margin: 24px 0 0">
              <a
                href="${ENV['sendLoginUrlPF']}"
                title="<%-it_pay_button_cta%>"
                style="background-color: #0B3EE3; border-radius: 8px; color: #FFFFFF; display: inline-block; font-size: 16px; font-weight: 600; line-height: 20px; padding: 14px 24px; text-decoration: none"
              ><%-it_pay_button_cta%></a>
            </p>
            </#if>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- IO app banner -->
      <mj-section css-class="section" padding="0 24px">
        <mj-group
          background-color="#D9F6F8"
          css-class="banner-box"
          vertical-align="middle"
        >
          <mj-column width="75%" padding="16px 0 16px 16px" vertical-align="middle">
            <mj-text
              align="left"
              font-size="14px"
              line-height="21px"
              padding="0"
            >
              <p style="font-size: 16px; font-weight: 700; line-height: 23px; margin: 0 0 6px; color: #031344"><%-it_io_banner_title%></p>
              <p style="margin: 0 0 12px; color: #555C70"><%-it_io_banner_text%></p>
              <a href="https://io.italia.it/" title="<%-it_io_banner_cta%>" style="color: #0073E6; font-size: 15px; font-weight: 700; line-height: 22px; text-decoration: none"><%-it_io_banner_cta%></a>
            </mj-text>
          </mj-column>
          <mj-column width="25%" padding="16px 16px 16px 8px" vertical-align="middle">
            <mj-image
              align="right"
              alt="Logo di app IO"
              width="74px"
              padding="0"
              src="https://notifichedigitali.it/assets/IO_Icon_4x_d10ecf1838.png"
            />
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section css-class="section" padding="38px 24px 0">
        <mj-column>
          <mj-table
            css-class="text"
            color="#17324D"
            font-size="16px"
            padding="0 0 24px"
          >
            <tr>
              <td
                class="send-communication-text"
                style="line-height: 24px; vertical-align: middle; white-space: nowrap"
              >
                <%-it_send_communication%>
              </td>
              <td style="padding-left: 10px; vertical-align: middle; width: 75px">
                <img
                  src="https://www.notifichedigitali.it/static/generic_assets/aar-logo-short-small.png"
                  alt="SEND - Servizio Notifiche Digitali"
                  width="75"
                  style="display: block; height: auto; max-width: 75px; width: 75px"
                />
              </td>
              <td aria-hidden="true" style="width: 100%"></td>
            </tr>
          </mj-table>

          <mj-divider
            border-color="#E3E7EB"
            border-style="solid"
            border-width="1px"
            padding="0"
          />

          <mj-text
            css-class="footer-text"
            align="left"
            padding="24px 0"
          >
            <p style="margin: 0; font-size: 14px; line-height: 18px; color: #5C6F82"><%-it_footer%></p>
          </mj-text>

          <mj-divider
            border-color="#E3E7EB"
            border-style="solid"
            border-width="1px"
            padding="0 0 24px"
          />
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>

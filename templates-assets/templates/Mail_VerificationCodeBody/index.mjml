<mjml lang="it">
  <mj-head>
    <mj-title>SEND - Conferma la tua email</mj-title>
    <mj-attributes>
      <mj-all font-family="system-ui, sans-serif" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
  </mj-head>

  <mj-body css-class="mail-body">
    <mj-include path="../../styles/style.css" type="css" />
    <mj-wrapper>
      <!-- PagoPA Logo -->
      <mj-include text-align="left" padding="0" path="../partials/main-logo-verification.mjml" />
      <mj-section css-class="section" padding-bottom="0px" padding-top="0px">
        <mj-column>
          <!-- Title -->
          <mj-text
            css-class="text"
            font-weight="bold"
            align="left"
            padding-top="16px"
            padding-bottom="16px"
            color="#17324D"
          >
            <!-- H4 Desktop (from MUI Italia)-->
            <h1 style="font-size: 32px; line-height: 40px; margin: 0">SEND - 
            <% if (noIta) { %>
            <span lang="<%-language%>"><%-subject%></span>
            <span aria-hidden="true"> &bull; </span>
            <% } %>
            <%-it_subject%>
            </h1>
          </mj-text>

          <!-- Main Message -->
          <mj-text
            css-class="text"
            font-size="18px"
            line-height="24px"
            font-weight="regular"
            align="left"
            padding-top="16px"
            padding-bottom="0px"
            color="#17324D"
          >
            <p style="margin-top: 0px">
              <% if (noIta) { %>
              <span lang="<%-language%>"><%-hello%></span>
              <span aria-hidden="true"> &bull; </span>
              <% } %>
              <%-it_hello%>,
            </p>
          </mj-text>
          <mj-text
            css-class="text"
            font-size="18px"
            line-height="24px"
            font-weight="regular"
            align="left"
            padding-top="0px"
            color="#17324D"
          >
            <% if (noIta) { %>
            <p style="margin-top: 10px" lang="<%-language%>">
              <%-body1%>
            </p>
            <% } %>
            <p style="margin-top: 10px">
              <%-it_body1%>
            </p>
            <h5 style="font-size: 28px; line-heigth: 42px; margin-top: 50px">${verificationCode}</h5>
          </mj-text>
          <mj-text css-class="text" font-size="14px" line-height="20px" padding-bottom="0px" color="#17324D">
            <p style="margin-top: 0px; margin-bottom: 14 px">
              <% if (noIta) { %>
              <span lang="<%-language%>"><%-signature%></span>
              <span aria-hidden="true"> &bull; </span>
              <% } %>
              <%-it_signature%>,
            </p>
            <p style="margin: 0px">SEND - Servizio Notifiche Digitali</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <!-- Divider -->
      <mj-include path="../partials/divider.mjml" />
      <!-- Footer/Disclaimer -->
      <mj-section css-class="section" padding-bottom="16px" padding-top="0px">
        <mj-column>
          <mj-text
            css-class="footer-text"
            font-size="14px"
            line-height="20px"
            color="#17324D"
          >
          <% if (noIta) { %>
            <p style="margin-top: 0px; font-size: 14px" lang="<%-language%>">
              <%-footer%>
            </p>
          <% } %>
          <p style="margin-top: 0px; font-size: 14px">
            <%-it_footer%>
          </p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>

  },
  "item": [
    {
      "name": "Informal Communications",
      "description": "Endpoint PUT per i template delle comunicazioni bonarie informali.",
      "item": [
        {
          "name": "Informal Analog Communication - PDF",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-language",
                "value": "{{language}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "*/*",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iun\": \"AAAA-AAAA-AAAA-000000-A-0\",\n  \"subject\": \"Oggetto comunicazione bonaria\",\n  \"body\": {\n    \"primaryContent\": \"Corpo della comunicazione in lingua principale.\",\n    \"secondaryContent\": \"Body della comunicazione in lingua alternativa.\"\n  },\n  \"sender\": {\n    \"denomination\": \"Ente_Mittente\",\n    \"id\": \"Ente_Mittente_Id\",\n    \"service\": \"Service\"\n  },\n  \"recipient\": {\n    \"denomination\": \"Nome Cognome\",\n    \"taxId\": \"AAAAAA00A00A000A\",\n    \"recipientType\": \"PF\"\n  },\n  \"hasAttachment\": false,\n  \"hasPayment\": true,\n  \"checkoutUrl\": \"https://test.url\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/templates-engine-private/v1/templates/informal/analog-communication",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "templates-engine-private",
                "v1",
                "templates",
                "informal",
                "analog-communication"
              ]
            },
            "description": "Genera un documento PDF per il canale analogico delle comunicazioni bonarie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text()).to.not.be.empty;",
                  "});",
                  "",
                  "// Expected response: PDF"
                ]
              }
            }
          ]
        },

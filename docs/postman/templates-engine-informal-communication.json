          ]
        },
        "description": "Genera un messaggio di testo per il canale SMS delle comunicazioni bonarie."
      },
      "response": []
    },
    {
      "name": "Generate Base64 QR Code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/templates-engine-private/v1/qrcode-generator?url={{qrCodeUrl}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "templates-engine-private",
            "v1",
            "qrcode-generator"
          ],
          "query": [
            {
              "key": "url",
              "value": "{{qrCodeUrl}}",
              "description": "URL da trasformare in QR Code base64"
            }
          ]
        },
        "description": "Genera un QR Code in formato base64 a partire da un URL."
      },
      "response": []
    }
  ]
}
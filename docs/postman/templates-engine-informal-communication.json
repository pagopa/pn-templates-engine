            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "text/plain",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderPaDenomination\": \"Ente_Mittente\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/templates-engine-private/v1/templates/informal/sms-communication",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "templates-engine-private",
            "v1",

{
  "info": {
    "name": "Templates Engine - Informal Communication",
    "description": "Collection Postman per generare template comunicazioni bonarie informali e QR Code. Usa la variabile {{baseUrl}} per modificare l'host.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8099",
      "type": "string"
    },
    {
      "key": "language",
      "value": "IT",
      "type": "string"
    },
    {
      "key": "qrCodeUrl",
      "value": "https://example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Informal Analog Communication - PDF",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-language",
            "value": "{{language}}",
            "type": "text",
            "description": "Lingua del documento"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/pdf",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"iun\": \"AAAA-AAAA-AAAA-000000-A-0\",\n  \"subject\": \"Oggetto\",\n  \"hasAttachment\": false,\n  \"hasPayment\": true,\n  \"body\": {\n    \"primaryContent\": \"Corpo della comunicazione\",\n    \"secondaryContent\": \"Testo secondario opzionale\"\n  },\n  \"sender\": {\n    \"paDenomination\": \"Ente_Mittente\",\n    \"paId\": \"Ente_Mittente_Id\"\n  },\n  \"recipient\": {\n    \"denomination\": \"Nome Cognome\",\n    \"taxId\": \"AAAAAA00A00A000A\",\n    \"recipientType\": \"PF\",\n    \"isIoUser\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/templates-engine-private/v1/templates/informal/analog-communication",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "templates-engine-private",
            "v1",
            "templates",
            "informal",
            "analog-communication"
          ]
        },
        "description": "Genera un documento PDF per il canale analogico delle comunicazioni bonarie."
      },
      "response": []
    },
